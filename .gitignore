# ==============================================================================
# CyberSec Ranch - Git Ignore Rules
# ==============================================================================

# Environment files containing active flags and local secrets
.env
!.env.example

# Python cache & runtime
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
dist/
*.egg-info/

# Compiled challenge binaries (compiled inside Docker during build)
labs/custom-challenges/buffer-overflow-arena/vuln

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Logs & temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.pid

# Docker local overrides
docker-compose.override.yml
